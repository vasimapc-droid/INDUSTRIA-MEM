import { NavLink } from 'react-router-dom';
import {
  LayoutDashboard, Factory, AlertTriangle, BookOpen, Bot, Users,
  Bell, BarChart3, User, Settings, Mic, ShieldCheck, Settings2
} from 'lucide-react';
import { useAuth } from '../context/AuthContext';

export default function Sidebar() {
  const { user } = useAuth();

  const baseItems = [
    { to: '/', label: 'Dashboard', icon: LayoutDashboard },
    { to: '/machines', label: 'Machines', icon: Factory },
    { to: '/incidents', label: 'Incidents', icon: AlertTriangle },
    { to: '/knowledge', label: 'Knowledge Base', icon: BookOpen },
    { to: '/ask-ai', label: 'Ask AI', icon: Bot },
    { to: '/notifications', label: 'Notifications', icon: Bell }
  ];

  const roleItems = {
    TECHNICIAN: [
      { to: '/voice-capture', label: 'Voice Capture', icon: Mic },
      { to: '/ask-expert', label: 'Ask an Expert', icon: Users },
      { to: '/expert-finder', label: 'Find Expert', icon: Users }
    ],
    EXPERT: [
      { to: '/pending-verification', label: 'Verification', icon: ShieldCheck },
      { to: '/voice-capture', label: 'Voice Capture', icon: Mic }
    ],
    ADMIN: [
      { to: '/admin', label: 'Administration', icon: Settings2 },
      { to: '/pending-verification', label: 'Verification', icon: ShieldCheck },
      { to: '/reports', label: 'Reports', icon: BarChart3 }
    ]
  };

  const tailItems = [
    { to: '/profile', label: 'Profile', icon: User },
    { to: '/settings', label: 'Settings', icon: Settings }
  ];

  const items = [...baseItems, ...(roleItems[user?.role] || []), ...tailItems];

  return (
    <aside className="w-64 bg-navy-900 text-white flex flex-col">
      <div className="p-5 border-b border-white/10">
        <h1 className="text-lg font-bold tracking-wide">INDUSTRIA-MEM</h1>
        <p className="text-xs text-slate-400 mt-1">Knowledge Continuity</p>
      </div>
      <nav className="flex-1 p-3 space-y-1 overflow-y-auto">
        {items.map(({ to, label, icon: Icon }) => (
          <NavLink key={to} to={to} end={to === '/'}
            className={({ isActive }) =>
              'flex items-center gap-3 px-3 py-2 rounded-lg text-sm transition ' +
              (isActive ? 'bg-brand-600 text-white' : 'text-slate-300 hover:bg-white/5')}>
            <Icon size={18} />
            <span>{label}</span>
          </NavLink>
        ))}
      </nav>
      <div className="p-4 border-t border-white/10 text-xs text-slate-400">
        v1.0 · {user?.role || 'Guest'}
      </div>
    </aside>
  );
}